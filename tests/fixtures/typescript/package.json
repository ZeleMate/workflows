    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.0.0",
    "prettier": "^3.6.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
